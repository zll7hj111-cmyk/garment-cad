{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "默认构建 (Debug)",
      "description": "Ninja + MSVC，自动导出 compile_commands.json 供 clangd 使用",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/out",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "$env{QT_DIR}"
        }
      },
      "environment": {
        "QT_DIR": "$penv{QT_DIR}"
      },
      "vendor": {
        "qt-project.org/qt": {
          "hint": "设置环境变量 QT_DIR 指向 Qt6 安装路径的 msvc2022_64 目录，例如 C:/Qt/6.11.1/msvc2022_64；Ninja 构建需在 vcvars64 环境（或 tools/build.bat）下执行"
        }
      }
    },
    {
      "name": "release",
      "displayName": "Release 构建",
      "description": "Ninja + MSVC Release（独立目录 build/out-rel）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/out-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "$env{QT_DIR}"
        }
      },
      "environment": {
        "QT_DIR": "$penv{QT_DIR}"
      },
      "vendor": {
        "qt-project.org/qt": {
          "hint": "设置环境变量 QT_DIR 指向 Qt6 安装路径的 msvc2022_64 目录，例如 C:/Qt/6.11.1/msvc2022_64"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Debug 构建",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "displayName": "Release 构建",
      "configurePreset": "release"
    }
  ]
}
