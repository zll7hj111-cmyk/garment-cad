{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "默认构建",
      "description": "使用 Visual Studio 生成器，无需额外环境配置",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/out",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "$env{QT_DIR}"
        }
      },
      "environment": {
        "QT_DIR": "$penv{QT_DIR}"
      },
      "vendor": {
        "qt-project.org/qt": {
          "hint": "设置环境变量 QT_DIR 指向 Qt6 安装路径的 msvc2022_64 目录，例如 C:/Qt/6.11.1/msvc2022_64"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Debug 构建",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release 构建",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
